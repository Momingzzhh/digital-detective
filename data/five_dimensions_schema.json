{
  "$defs": {
    "ActorAssessment": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Aliases",
          "type": "array"
        },
        "participation": {
          "enum": [
            "直接实施",
            "组织指使",
            "帮助配合",
            "无法确认"
          ],
          "title": "Participation",
          "type": "string"
        },
        "role": {
          "maxLength": 160,
          "minLength": 4,
          "title": "Role",
          "type": "string"
        },
        "sentence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Sentence Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "aliases",
        "participation",
        "role",
        "sentence_ids"
      ],
      "title": "ActorAssessment",
      "type": "object"
    },
    "Contradiction": {
      "additionalProperties": false,
      "properties": {
        "left_id": {
          "title": "Left Id",
          "type": "string"
        },
        "right_id": {
          "title": "Right Id",
          "type": "string"
        },
        "left_quote": {
          "title": "Left Quote",
          "type": "string"
        },
        "right_quote": {
          "title": "Right Quote",
          "type": "string"
        },
        "issue": {
          "title": "Issue",
          "type": "string"
        },
        "resolution": {
          "title": "Resolution",
          "type": "string"
        },
        "resolution_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Resolution Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "left_id",
        "right_id",
        "left_quote",
        "right_quote",
        "issue",
        "resolution",
        "resolution_evidence_ids"
      ],
      "title": "Contradiction",
      "type": "object"
    },
    "EventAnnotation": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "maxLength": 180,
          "minLength": 4,
          "title": "Claim",
          "type": "string"
        },
        "sentence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Sentence Ids",
          "type": "array"
        }
      },
      "required": [
        "claim",
        "sentence_ids"
      ],
      "title": "EventAnnotation",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ],
          "title": "Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "depends_on_steps": {
          "items": {
            "enum": [
              "L1",
              "L2",
              "L3",
              "L4",
              "L5"
            ],
            "type": "string"
          },
          "title": "Depends On Steps",
          "type": "array"
        }
      },
      "required": [
        "id",
        "claim",
        "evidence_ids",
        "depends_on_steps"
      ],
      "title": "Step",
      "type": "object"
    },
    "Tier": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "tier": {
          "enum": [
            "直接观察或原始记录",
            "间接印证",
            "转述或背景"
          ],
          "title": "Tier",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "tier"
      ],
      "title": "Tier",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_hierarchy": {
      "items": {
        "$ref": "#/$defs/Tier"
      },
      "title": "Evidence Hierarchy",
      "type": "array"
    },
    "logic_chain": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "maxItems": 5,
      "minItems": 3,
      "title": "Logic Chain",
      "type": "array"
    },
    "contradictions": {
      "items": {
        "$ref": "#/$defs/Contradiction"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "candidate_names": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Names",
      "type": "array"
    },
    "event_sentence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 3,
      "title": "Event Sentence Ids",
      "type": "array"
    },
    "actor_assessments": {
      "items": {
        "$ref": "#/$defs/ActorAssessment"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Actor Assessments",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EventAnnotation"
      },
      "maxItems": 10,
      "minItems": 3,
      "title": "Events",
      "type": "array"
    },
    "complete_actor_coverage": {
      "title": "Complete Actor Coverage",
      "type": "boolean"
    },
    "complete_event_coverage": {
      "title": "Complete Event Coverage",
      "type": "boolean"
    }
  },
  "required": [
    "evidence_hierarchy",
    "logic_chain",
    "contradictions",
    "candidate_names",
    "event_sentence_ids",
    "actor_assessments",
    "events",
    "complete_actor_coverage",
    "complete_event_coverage"
  ],
  "title": "FiveDimensions",
  "type": "object"
}
